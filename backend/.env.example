# GEN SAFE EXAM API — environment example
# NEVER commit real secrets. Secrets live only here, server-side.

NODE_ENV=production
PORT=4000

# PostgreSQL (with pgvector extension)
DATABASE_URL=postgres://gse_user:CHANGE_ME@localhost:5432/gen_safe_exam

# Auth
JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_REFRESH_SECRET=another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h
COOKIE_DOMAIN=gensexam.example.edu

# Vault encryption (32-byte hex keys — rotate via KMS in production)
VAULT_ENC_KEY=64-hex-chars
VAULT_HASH_PEPPER=random-pepper

# AI providers (server-side ONLY — never exposed to the frontend)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
AI_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# Rate limiting / lockout policy
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
