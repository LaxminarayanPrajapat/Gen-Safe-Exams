# GEN SAFE EXAM — environment example (frontend)
# The React app must never contain secret keys.
# All AI / DB credentials live in backend/.env

# Base URL of the Express API (leave as-is for the demo, which runs fully client-side in DEMO MODE)
VITE_API_BASE_URL=http://localhost:4000/api

# Set to "true" to run the UI against the bundled demo dataset instead of a live API
VITE_DEMO_MODE=true
